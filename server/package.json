{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express API for TaleCrafter AI",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "build": "npm run check && npm test",
    "start": "node src/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:verify": "RUN_DATABASE_TESTS=true node --test test/database.integration.test.js",
    "migrate": "npm run db:migrate",
    "user:set-role": "node scripts/set-user-role.js",
    "test": "node --test test/env.test.js test/storage.test.js",
    "test:auth": "RUN_AUTH_TESTS=true node --test test/auth.integration.test.js",
    "test:integration": "RUN_INTEGRATION_TESTS=true node --test test/payment.integration.test.js",
    "test:generation": "RUN_GENERATION_TESTS=true node --test test/generation.integration.test.js",
    "test:storage": "RUN_STORAGE_TESTS=true node --test test/storage.integration.test.js",
    "check": "npm run lint && npm run format:check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Aditya Shriwas",
  "license": "ISC",
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^1.1.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "prettier": "^3.7.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.11"
  }
}
