# Runtime: application
NODE_ENV=production
PORT=8000
CORS_ORIGIN=https://app.example.com
CLIENT_ORIGIN=https://app.example.com
# Verify forwarding headers on every production ingress before changing trust.
TRUST_PROXY=1

# Runtime: Neon Postgres and Managed Auth
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Runtime: story generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CREATE_STORY_PROMPT=
POLLINATIONS_APP_KEY=pk_your_app_key
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
POLLINATIONS_TOKEN_ENCRYPTION_KEY=
# Server-only funded secret key, never the publishable pk_ App Key.
POLLINATIONS_PLATFORM_KEY=
# Hard cap on paid image attempts across all subscribers each UTC month.
POLLINATIONS_PLATFORM_MONTHLY_ATTEMPT_LIMIT=1000

# Runtime: persistent media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_STORY_FOLDER=talecrafter/stories

# Runtime: Razorpay payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CREATOR_PLAN_ID=
# Keep false for the initial Free launch. Razorpay and platform keys are optional
# while checkout is disabled; never remove keys needed by existing subscribers.
# Enable only after migrations, test billing, and a funded platform key.
CREATOR_CHECKOUT_ENABLED=false

# Local database tooling only; do not add these to the deployed API.
DATABASE_URL_UNPOOLED=
NEON_BRANCH=dev/your-name
